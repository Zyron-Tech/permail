# ---- Supabase ----------------------------------------------------------------
# Dashboard: Project Settings -> API Keys
# (older projects: Project Settings -> API -> Project API keys)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# "Publishable key" in the current dashboard, "anon / public" in the old one.
# Safe to ship to the browser — row-level security is what protects your data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# "Secret key" in the current dashboard, "service_role" in the old one.
# BYPASSES ALL RLS. Server-side only — never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx

# ---- Google OAuth ------------------------------------------------------------
# The same client you configured under Supabase Auth -> Providers -> Google.
# Permail needs it server-side too, to refresh the Gmail token while sending.
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx

# ---- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
